<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.PizzariaDAOeSERVICE.view.ClienteEditController"
      spacing="14" alignment="TOP_CENTER" style="-fx-padding: 30; -fx-background-color: white;">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="🏠 Home" onAction="#irParaHome"
                style="-fx-background-color: #6e5249; -fx-text-fill: white; -fx-background-radius: 8;" />
        <Label text="Editar CLIENTE" style="-fx-font-size: 18px;" />
    </HBox>

    <Label text="Nome:" />
    <TextField fx:id="campoNome" maxWidth="400" />

    <Label fx:id="labelCpf" text="CPF: " />

    <Label text="Endereço:" />
    <TextField fx:id="campoEndereco" maxWidth="400" />

    <Label fx:id="labelErro" style="-fx-text-fill: #e24b4a; -fx-font-size: 12px;" wrapText="true" maxWidth="400" />

    <Button text="Confirmar Mudança" onAction="#confirmarMudanca" prefWidth="220" prefHeight="36"
            style="-fx-background-color: #ef9f27; -fx-text-fill: #412402;" />
    <Button text="EXCLUIR CLIENTE" onAction="#excluirCliente" prefWidth="220" prefHeight="36"
            style="-fx-background-color: #e24b4a; -fx-text-fill: white;" />
    <Button text="Voltar" onAction="#voltar" prefWidth="220" prefHeight="32" />
</VBox>
