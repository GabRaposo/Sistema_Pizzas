<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ufersa.PizzariaDAOeSERVICE.view.HomeController"
            style="-fx-background-color: white;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 14 20; -fx-border-color: #d3d1c7; -fx-border-width: 0 0 1 0;">
            <Label text="🍕 Papa's Pizzeria" style="-fx-font-size: 16px;" />
            <Label fx:id="labelTipoUsuario" text="Funcionário"
                   style="-fx-background-color: #e24b4a; -fx-text-fill: white; -fx-padding: 6 14; -fx-background-radius: 16;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 30;">
            <Button text="Registrar Pedido" onAction="#irParaRegistrarPedido"
                    prefWidth="260" prefHeight="180"
                    style="-fx-background-color: #e24b4a; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 12;" />

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="botaoPizzasRegistradas" text="Pizzas Registradas" onAction="#irParaPizzas"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #ba7517; -fx-text-fill: white;" />
                <Button text="Clientes" onAction="#irParaClientes"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #ba7517; -fx-text-fill: white;" />
                <Button text="Estoque de adicionais" onAction="#irParaEstoque"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #ba7517; -fx-text-fill: white;" />
            </HBox>
            <HBox alignment="CENTER" spacing="20">
                <Button text="Histórico de pedidos" onAction="#irParaHistorico"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #ba7517; -fx-text-fill: white;" />
                <Button fx:id="botaoRelatorio" text="Relatório" onAction="#irParaRelatorio"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #ba7517; -fx-text-fill: white;" />
                <Button text="🔍 Buscar" onAction="#irParaBusca"
                        prefWidth="180" prefHeight="44"
                        style="-fx-background-color: #4a7a9b; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
