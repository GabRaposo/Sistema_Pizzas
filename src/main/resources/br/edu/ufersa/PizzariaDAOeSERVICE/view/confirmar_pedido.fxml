<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.PizzariaDAOeSERVICE.view.ConfirmarPedidoController"
      spacing="14" style="-fx-padding: 24; -fx-background-color: white;">

    <Button text="🏠 Home" onAction="#irParaHome"
            style="-fx-background-color: #6e5249; -fx-text-fill: white; -fx-background-radius: 8;" />

    <HBox spacing="24">
        <VBox spacing="10" prefWidth="420" style="-fx-background-color: #f1efe8; -fx-padding: 16; -fx-background-radius: 8;">
            <Label text="Resumo do pedido:" style="-fx-font-size: 16px;" />
            <ListView fx:id="listaResumo" prefHeight="280" />
            <Label fx:id="labelSubtotal" text="Subtotal: R$ 0,00" style="-fx-font-size: 16px;" />
        </VBox>

        <VBox spacing="16" prefWidth="420">
            <Button text="Cliente" onAction="#escolherCliente" prefWidth="200" prefHeight="36"
                    style="-fx-background-color: #e24b4a; -fx-text-fill: white;" />
            <Label fx:id="labelCliente" text="Nenhum cliente selecionado" wrapText="true"
                   style="-fx-background-color: #f1efe8; -fx-padding: 10; -fx-background-radius: 8;" />

            <Label text="Forma de pagamento:" />
            <HBox spacing="20">
                <fx:define>
                    <ToggleGroup fx:id="grupoPagamento" />
                </fx:define>
                <RadioButton fx:id="radioPix" text="Pix" toggleGroup="$grupoPagamento" selected="true" />
                <RadioButton fx:id="radioCartao" text="Cartão" toggleGroup="$grupoPagamento" />
            </HBox>

            <Label text="Modo de entrega:" />
            <HBox spacing="20">
                <fx:define>
                    <ToggleGroup fx:id="grupoEntrega" />
                </fx:define>
                <RadioButton fx:id="radioRetirada" text="Retirada" toggleGroup="$grupoEntrega" selected="true" />
                <RadioButton fx:id="radioEntrega" text="Entrega" toggleGroup="$grupoEntrega" />
            </HBox>

            <Label fx:id="labelErro" style="-fx-text-fill: #e24b4a; -fx-font-size: 12px;" wrapText="true" />

            <Button text="Confirmar →" onAction="#confirmar" prefWidth="200" prefHeight="40"
                    style="-fx-background-color: #ef9f27; -fx-text-fill: #412402;" />
        </VBox>
    </HBox>
</VBox>
