<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.PizzariaDAOeSERVICE.view.ClienteListController"
      spacing="14" style="-fx-padding: 24; -fx-background-color: white;">

    <Button text="🏠 Home" onAction="#irParaHome"
            style="-fx-background-color: #6e5249; -fx-text-fill: white; -fx-background-radius: 8;" />

    <HBox spacing="24">
        <VBox spacing="10" prefWidth="380">
            <Label text="Cadastrar Novo Cliente" style="-fx-font-size: 16px;" />
            <TextField fx:id="campoNome" promptText="Nome" />
            <TextField fx:id="campoCpf" promptText="CPF: xxx.xxx.xxx-xx" />
            <TextField fx:id="campoEndereco" promptText="Digite o endereço..." />
            <Label fx:id="labelErro" style="-fx-text-fill: #e24b4a; -fx-font-size: 12px;" wrapText="true" />
            <Button text="Confirmar" onAction="#cadastrar" prefWidth="200" prefHeight="36"
                    style="-fx-background-color: #e24b4a; -fx-text-fill: white;" />
        </VBox>

        <VBox spacing="10" prefWidth="500">
            <Label fx:id="labelTituloLista" text="Clientes" style="-fx-font-size: 16px;" />
            <ListView fx:id="listaClientes" prefHeight="400" />
        </VBox>
    </HBox>
</VBox>
