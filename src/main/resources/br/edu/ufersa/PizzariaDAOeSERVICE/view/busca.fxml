<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.edu.ufersa.PizzariaDAOeSERVICE.view.BuscaController"
      spacing="16" style="-fx-padding: 24; -fx-background-color: white;">

    <!-- Cabeçalho -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="🏠 Home" onAction="#irParaHome"
                style="-fx-background-color: #6e5249; -fx-text-fill: white; -fx-background-radius: 8;" />
        <Label text="Busca" style="-fx-font-size: 18px;" />
    </HBox>

    <!-- Seletor de tipo de busca -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: #f1efe8; -fx-padding: 12; -fx-background-radius: 8;">
        <Label text="Buscar:" style="-fx-font-size: 14px;" />
        <ComboBox fx:id="comboBusca" prefWidth="260" onAction="#atualizarFormulario" />
    </HBox>

    <!-- Formulário de filtro (dinâmico) -->
    <HBox fx:id="boxFiltro" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="labelFiltro" text="Filtro:" />
        <TextField fx:id="campoFiltro" promptText="Digite o valor..." prefWidth="280" />
        <ComboBox fx:id="comboFiltroEstado" prefWidth="160" visible="false" managed="false" />
        <ComboBox fx:id="comboFiltroPizza" prefWidth="200" visible="false" managed="false" />
        <Button text="Buscar" onAction="#executarBusca"
                style="-fx-background-color: #e24b4a; -fx-text-fill: white; -fx-background-radius: 6;" />
    </HBox>

    <Label fx:id="labelErro" style="-fx-text-fill: #e24b4a; -fx-font-size: 12px;" wrapText="true" />

    <!-- Resultado -->
    <Label fx:id="labelResultado" text="Resultados:" style="-fx-font-size: 14px;" />
    <ListView fx:id="listaResultado" prefHeight="400" />
</VBox>
